# =====================================================
#  Memories — Variáveis de ambiente
#  Copie este arquivo para .env.local e preencha os valores
# =====================================================

# URL pública do seu projeto Supabase
# Encontre em: Supabase → Project Settings → API → Project URL
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Anon/Public key do Supabase (segura para expor no client)
# Encontre em: Supabase → Project Settings → API → anon public
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# URL do site (usada no callback OAuth)
# Em desenvolvimento: http://localhost:3000
# Em produção: https://seu-dominio.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000
